# Railway sets PORT. Leave it out.
# Postgres: use a reference to the Railway Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Helius mainnet RPC with your key (getProgramAccounts must be allowed)
RPC_URL=
# Your Vercel domain, so the browser can call this API
SITE_ORIGIN=https://holdipo.fun
# Jupiter: works without a key, but set one for production so quotes are not rate limited.
# With a key from portal.jup.ag use JUPITER_API_URL=https://api.jup.ag
JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

PRODUCT=holdipo
TICKER=$IPO
# The listener watches the deploy wallet for a new pump.fun coin whose address ends with this
# the exact last characters of the vanity CA, case matters (Solana addresses have no 0, O, I or lowercase l)
MINT_SUFFIX=ipo
# Only set this to skip the listener and point at a coin that already exists
TOKEN_MINT=

# A fresh wallet that only pays holders. Create with: npm run new-wallet
# Fund it with 0.05 SOL for network fees before launch.
TREASURY_SECRET=

# Rules (these are what the site shows)
SPLIT_MINUTES=10
MIN_HOLD_USD=20
MIN_SOL_PAYOUT_LAMPORTS=1000000
TREASURY_RESERVE_LAMPORTS=20000000
# Extra wallets that never count as holders, comma separated (team wallets etc.)
EXCLUDE_WALLETS=

# Switches. DRY_RUN=true computes splits without claiming or paying.
SPLITS_ENABLED=true
PAYOUTS_ENABLED=true
DRY_RUN=false

# holdipo: the deploy wallet's secret. It launches the coin and claims its creator fees.
CREATOR_SECRET=
HOLDER_SHARE_BPS=10000
DEDUCT_COSTS=true
MIN_STOCK_USD=10
# PreStocks token mints (defaults shown)
OPENAI_MINT=PreweJYECqtQwBtpxHL171nL2K6umo692gTm7Q3rpgF
ANTHROPIC_MINT=Pren1FvFX6J3E4kXhJuCiAD5aDmGEb7qJRncwA8Lkhw
