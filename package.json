{
  "name": "holdipo-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/core/split.test.ts",
    "test:db": "tsx --test src/core/keeper.int.test.ts",
    "check": "tsx src/scripts/check-live.ts",
    "reset-launch": "tsx src/scripts/reset-launch.ts",
    "check:claim": "tsx src/scripts/check-claim.ts",
    "simulate:stock": "tsx src/scripts/simulate-stock.ts",
    "new-wallet": "tsx src/scripts/new-wallet.ts",
    "railway:secret": "tsx src/scripts/railway-secret.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "4.3.1",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "postgres": "3.4.7",
    "tsx": "4.20.6",
    "tweetnacl": "1.0.3",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.23",
    "@types/node": "22.18.8"
  }
}
